<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sample Git Repository Page</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 720px;
      margin: 4rem auto;
      padding: 0 1.25rem;
      line-height: 1.6;
      color: #1f2328;
      background-color: #f6f8fa;
    }
    .card {
      background: #ffffff;
      border: 1px solid #d0d7de;
      border-radius: 8px;
      padding: 2rem;
    }
    button {
      background-color: #1f883d;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      padding: 0.5rem 1rem;
      font-size: 0.95rem;
      cursor: pointer;
    }
    button:hover {
      background-color: #1a7f37;
    }
    #status {
      margin-top: 1rem;
      font-weight: 600;
      color: #0969da;
    }
  </style>
</head>
<body>
  <main class="card">
    <h1>Hello, Git!</h1>
    <p>This sample HTML file is ready to stage, commit, and push to your repository.</p>
    <button id="ping-btn" type="button">Test Interactive Script</button>
    <p id="status" aria-live="polite"></p>
  </main>

  <script>
    const button = document.getElementById("ping-btn");
    const status = document.getElementById("status");
    let clicks = 0;

    button.addEventListener("click", () => {
      clicks += 1;
      status.textContent = `Button clicked ${clicks} time${clicks === 1 ? "" : "s"}.`;
    });
  </script>
</body>
</html>
